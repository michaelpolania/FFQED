{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug main (single rank)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/main",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "lldb",
      "preLaunchTask": "make",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Attach to rank 0",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/main",
      "MIMode": "lldb",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Attach to rank 0 (CodeLLDB)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/main",
      "pid": "${command:pickMyProcess}"
    }
  ]
}


