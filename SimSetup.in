# File name for output H5 file (excluding file extension)
OutputFile: EMHD_Sim_Data_ShortTime

# Order of Runge-Kutta timestep method (2 or 3)
RK_order: 2

# true for varying cell-center spacing in "radial"- (x-)direction or false otherwise. Defaults to false if unspecified.
varying_mesh: false

# True when QED corrections are included (D = E (8pikappa(E^2-c^2B^2)) + E; kappa is nonzero)
QED_corrections: false

# Resolution in x-direction
Nx: 200

# Resolution in y-direction
Ny: 100

# Lower limit of simulation domain in x-direction in cm
x_min: 0

# Upper limit of simulation domain in x-direction in cm, 100 r* = 10^8 cm
x_max: 1e8

# Lower limit of simulation domain in y-direction in cm
y_min: -5e5

# Upper limit of simulation domain in y-direction in cm
y_max: 5e5

# Maximum time in years, originally 5e2 1.057e-11
t_max: 1.0e-12

# Courant number
k_C: 0.50

# Maximum number of snapshots to save to H5 file 500
saves_number: 200

# Cadence (number of timesteps) to print energy conservation information to terminal, 1
ECons_cadence: 1

# Print out divB calculation every ECons_cadence timesteps (true = on or false = off)
divBCheck: false

#Initial uniform Bx and By field, specified by magnitude B_pol_init (in G) and angle to the horizontal theta_B (in degrees)
B_pol_init: 1e14
theta_B: 90

#Initial uniform Dx and Dy field, specified by magnitude D_pol_init (in G) and angle to the horizontal theta_D (in degrees)
D_pol_init: 1e14
theta_D: 90

#Initial Bz field B_tor_init on (true) or off (false), specified by its maximum value B_tor_max (in G), x-position center and width (B_tor_x_center,B_tor_x_width) (in cm)
# and y-position center and width (B_tor_y_center,B_tor_y_width) (in cm) #8.4e4
B_tor_init: false
B_tor_max: 0
B_tor_x_center: 0
B_tor_x_width: 1e3
B_tor_y_center: 0
B_tor_y_width: 1e15

#Initial Dz field D_tor_init on (true) or off (false), specified by its maximum value D_tor_max (in G), x-position center and width (D_tor_x_center,D_tor_x_width) (in cm)
# and y-position center and width (D_tor_y_center,D_tor_y_width) (in cm) #8.4e4
D_tor_init: false
D_tor_max: -1e13
D_tor_x_center: 0
D_tor_x_width: 1e3
D_tor_y_center: 0
D_tor_y_width: 1e15

# Lower boundary conditions on perpendicular magnetic field i.e., Bx ("perfect_conducting" = 0 or "continuous")
B_perp_lower: continuous

# Lower boundary conditions on perpendicular displacement field i.e., Dx ("perfect_conducting" = 0 or "continuous")
D_perp_lower: continuous

# Lower boundary conditions on parallel magnetic field i.e., By and Bz ("perfect_conducting" = continuous or "zero" = 0 or "shearing" = continuous By, Bz time-dependent function)
# If "shearing", B_parallel_shear_type options include:
# "uniform": fixes constant shearing field with magnitudes B_y = B_parallel_lower_shear_y and B_z = B_parallel_lower_shear_z (in G). Need to use E_parallel_lower = "continuous"
# "current_sheet": uses current sheet at y=0 with magnitude B_z = B_parallel_lower_shear_z (in G) on either side of sheet
B_parallel_lower: zero 
B_parallel_shear_type: uniform
B_parallel_lower_shear_By: 0
B_parallel_lower_shear_Bz: -1e13

# Lower boundary conditions on parallel displacement field i.e., Dy and Dz ("perfect_conducting" = continuous or "zero" = 0 or "shearing" = continuous Dy, Dz time-dependent function)
# If "shearing", D_parallel_shear_type options include:
# "uniform": fixes constant shearing field with magnitudes D_y = D_parallel_lower_shear_y and D_z = D_parallel_lower_shear_z (in G). Need to use E_parallel_lower = "continuous"
# "current_sheet": uses current sheet at y=0 with magnitude D_z = D_parallel_lower_shear_z (in G) on either side of sheet
D_parallel_lower: zero 
D_parallel_shear_type: uniform
D_parallel_lower_shear_By: 0
D_parallel_lower_shear_Bz: -1e13

# Lower boundary conditions on perpendicular electric field i.e., Ex ("perfect_conducting" = continuous)
E_perp_lower: zero

# Lower boundary conditions on parallel electric field i.e., Ey and Ez ("perfect_conducting" = 0 or "continuous")
E_parallel_lower: perfect_conducting

# Lower boundary conditions on perpendicular H field i.e., Hx ("perfect_conducting" = continuous)
H_perp_lower: continuous

# Lower boundary conditions on parallel H field i.e., Hy and Hz ("perfect_conducting" = 0 or "continuous")
H_parallel_lower: perfect_conducting

# Upper boundary condition on poloidal field i.e., Bx and By ("vacuum" = potential field or "continuous")
B_pol_upper: vacuum

# Upper boundary condition on toroidal field i.e., Bz ("vacuum" = 0 or "continuous")
B_tor_upper: vacuum

# Upper boundary condition on poloidal displacement field i.e., Dx and Dy ("vacuum" = potential field or "continuous")
D_pol_upper: vacuum

# Upper boundary condition on toroidal displacement field i.e., Dz ("vacuum" = 0 or "continuous")
D_tor_upper: vacuum

# Upper boundary conditions on perpendicular electric field i.e., Ex ("vacuum" = 0 or "continuous")
E_perp_upper: vacuum

# Upper boundary conditions on parallel electric field i.e., Ey and Ez ("vacuum" = 0 or "continuous")
E_parallel_upper: vacuum

# Upper boundary conditions on perpendicular H field i.e., Hx ("vacuum" = 0 or "continuous")
H_perp_upper: vacuum

# Upper boundary conditions on parallel electric field i.e., Hy and Hz ("vacuum" = 0 or "continuous")
H_parallel_upper: vacuum

# Velocity driver parameters in units of cm, cm/s and Hz
v_max: 1e4
v_y_center: 0
v_y_width: 1e5
v_f: 30.0
